{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vexis-key-store",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firekey_db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "STORE_NAME": "VEXIS KEY STORE"
  }
}
